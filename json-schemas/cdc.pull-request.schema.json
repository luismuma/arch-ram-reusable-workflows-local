{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdc.pull-request.schema.json",
  "title": "CDC Replication Configuration",
  "description": "Valida la estructura y los valores de una configuración de replicación CDC.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "env",
    "request_type",
    "project",
    "bbdd_engine",
    "bbdd_name",
    "tables",
    "replication_type",
    "target_engine",
    "kafka_cluster_name",
    "kafka_identity_pool",
    "kafka_topic_prefix",
    "target_info",
    "user_name",
    "cost_center",
    "change_number",
    "comments"
  ],

  "properties": {
    "env": {
      "type": "string",
      "enum": ["DEV", "PRE", "PRO", "${ENV}"],
      "description": "Entorno de ejecución de la replicación.",
      "examples": ["DEV", "PRE", "PRO"]
    },

    "request_type": {
      "type": "string",
      "enum": ["CREATE", "UPDATE", "DELETE", "${REQUEST_TYPE}"],
      "description": "Operación solicitada sobre la replicación."
    },

    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^((?!\\s)(?!.*\\s$).+|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\})$",
      "description": "Identificador del proyecto CDC o variable de plantilla."
    },

    "bbdd_engine": {
      "type": "string",
      "enum": [
        "ORACLE",
        "DB2",
        "MONGODB",
        "${BBDD_ENGINE}"
      ],
      "description": "Motor de base de datos de origen."
    },

    "bbdd_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^((?!\\s)(?!.*\\s$).+|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\})$",
      "description": "Nombre de la base de datos de origen o variable de plantilla."
    },

    "tables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "description": "Lista de tablas incluidas en la replicación.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^((?!\\s)(?!.*\\s$).+|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\})$"
      },
      "examples": [
        ["SOE.LOGON(*)", "SOE.ADDRESSES(*)"]
      ]
    },

    "replication_type": {
      "type": "string",
      "enum": ["ONLINE", "${REPLICATION_TYPE}"],
      "description": "Modalidad de replicación."
    },

    "target_engine": {
      "type": "string",
      "enum": ["KAFKA", "AWS-S3", "${TARGET_ENGINE}"],
      "description": "Motor de destino de la replicación."
    },

    "kafka_cluster_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^((?!\\s)(?!.*\\s$).+|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\})$",
      "description": "Nombre del clúster Kafka de destino o variable de plantilla."
    },

    "kafka_identity_pool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^((?!\\s)(?!.*\\s$).+|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\})$",
      "description": "Identificador del pool de identidades Kafka o variable de plantilla."
    },

    "kafka_topic_prefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 249,
      "pattern": "^([a-zA-Z0-9._-]+|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\})$",
      "description": "Prefijo utilizado para los topics Kafka o variable de plantilla."
    },

    "target_info": {
      "type": "string",
      "maxLength": 50,
      "pattern": "^(.*|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\})$",
      "description": "Información adicional del destino o variable de plantilla."
    },

    "user_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^((?!\\s)(?!.*\\s$).+|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\})$",
      "description": "Usuario solicitante de la replicación o variable de plantilla."
    },

    "cost_center": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^([A-Za-z0-9_-]+|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\})$",
      "description": "Código del centro de coste o variable de plantilla."
    },

    "change_number": {
      "type": "string",
      "maxLength": 25,
      "pattern": "^(.*|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\})$",
      "description": "Número de cambio asociado a la solicitud o variable de plantilla.",
      "examples": ["CHG123456"]
    },

    "comments": {
      "type": "string",
      "maxLength": 50,
      "pattern": "^(.*|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\})$",
      "description": "Comentarios adicionales de la solicitud o variable de plantilla."
    }
  }
}
