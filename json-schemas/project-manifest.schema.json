{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "version": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "archetype": {
            "type": "object",
            "required": [ "version" ],
            "properties": {
                "version": {
                    "type": "string" 
                }
            }
        }
    },
    "required": ["version", "name", "description"],
    "additionalProperties": false
}
